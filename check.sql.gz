GRANT ALL ON FUNCTION "counter"."create_store_and_profile"("store_name" "text", "first" "text", "last" "text") TO "service_role";



GRANT ALL ON FUNCTION "counter"."record_payment"("p_customer_id" "uuid", "p_amount_cents" integer) TO "authenticated";
GRANT ALL ON FUNCTION "counter"."record_payment"("p_customer_id" "uuid", "p_amount_cents" integer) TO "service_role";



