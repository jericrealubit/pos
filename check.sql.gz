ALTER TABLE ONLY "counter"."sale_items" FORCE ROW LEVEL SECURITY;


ALTER TABLE "counter"."sale_items" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "counter"."stores" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
